# syntax=docker/dockerfile:1
# Candidate only: build + security/translation validation are required before push.
# Never use a service-container snapshot, docker commit, or backup image here.
# Pinned digest of the locally inspected official image; no backup stage/assets.
FROM zyddnys/manga-image-translator@sha256:261c2d7ee114d9105e11210d6abc31c0552ac91f0cd65a8ef47db9eb345106d8

ARG SOURCE_REV=unknown
LABEL org.opencontainers.image.revision=$SOURCE_REV
WORKDIR /app
ENV PYTHONPATH="/app" \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MT_EXTRA_PACKAGES=""

# Install additional dependencies at BUILD time, never from deployment secrets.
# PaddleOCR 2.7.3 requires OpenCV <=4.6.0.66; newer headless wheels can force
# NumPy 2.x and overwrite the shared cv2 namespace. Keep ALL providers aligned.
# Do not reinstall requirements.txt: the pinned base already supplies MT/Torch.
# The base's ninja wheel fails pip check on this platform: replace that wheel.
RUN python -m pip install --no-cache-dir --force-reinstall --no-deps ninja==1.11.1.3 \
    && python -m pip install --no-cache-dir \
        numpy==1.26.4 \
        paddlepaddle==2.6.2 paddleocr==2.7.3 \
        opencv-python==4.6.0.66 \
        opencv-contrib-python==4.6.0.66 \
        opencv-python-headless==4.6.0.66 \
        pdf2docx==0.5.13 PyMuPDF==1.27.2.3 \
    && python -m pip check

# Local input is restricted by the deny-by-default .dockerignore. In particular,
# never COPY . /app, models/, fonts/, runtime output, credentials or host caches.
# Official models/fonts are already present; backup model hashes were identical.
COPY manga_translator/ /app/manga_translator/
COPY json_proxy.py /app/json_proxy.py
COPY docker_start.sh /app/docker_start.sh
COPY requirements.txt /app/requirements.txt
COPY docker_prepare.py /app/docker_prepare.py

# Build-time formatting only; never patch Python sources in a startup script.
RUN python -c "from pathlib import Path; p=Path('/app/docker_start.sh'); p.write_bytes(p.read_bytes().replace(b'\r\n', b'\n')); p.chmod(0o755)" \
    && bash -n /app/docker_start.sh \
    && python -m compileall -q /app/manga_translator /app/json_proxy.py /app/docker_prepare.py \
    && find /app/manga_translator /app/__pycache__ -name '*.pyc' -delete \
    && python -c "import numpy, cv2, paddle; import manga_translator; import json_proxy; assert numpy.__version__ == '1.26.4'; assert cv2.__version__ == '4.6.0'"

# Download/init the default Chinese Paddle detector/recognizer at build time.
# This performs no translation and uses no user images/API keys. Fail the build
# on missing models instead of relying on first-start downloads. Other optional
# engines/languages may still require their own explicit model preparation.
RUN python -c "from manga_translator.utils.paddle_engine import get_paddle_engine; get_paddle_engine(lang='ch', use_gpu=False)"

EXPOSE 5003
ENTRYPOINT []
# The source starter still supports legacy startup pip. Unset its trigger even
# if a deployment inherited MT_EXTRA_PACKAGES. Do not override this CMD with
# 'bash /app/docker_start.sh'; bake any future dependency into the image instead.
CMD ["env", "-u", "MT_EXTRA_PACKAGES", "bash", "/app/docker_start.sh"]
