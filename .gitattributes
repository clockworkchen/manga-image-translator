# Force LF line endings for shell scripts and Docker files
*.sh     text eol=lf
*.bash   text eol=lf
Dockerfile* text eol=lf

# Python and text files: normalize to LF
*.py     text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pt     binary
*.pth    binary
*.ckpt   binary
