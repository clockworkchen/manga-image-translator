# Deny by default. Only reviewed source files enter this build context.
# Keep this exact-file manifest in sync when adding source modules/resources.
# Do not replace it with !manga_translator/** (that admits nested user data).
# This context targets Dockerfile.custom, not the upstream COPY . workflow.
**
